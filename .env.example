NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173
PYTHON_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
AI_MTLS_REQUIRED=false
AI_MTLS_CA_PATH=
AI_MTLS_CERT_PATH=
AI_MTLS_KEY_PATH=
USER_JWT_PUBLIC_KEY_PATH=
USER_JWT_SECRET_PATH=
AI_CONTEXT_PRIVATE_KEY_PATH=
AI_CONTEXT_PUBLIC_KEY_PATH=
# Inline key material (takes precedence over the *_PATH variants).
# Use this on hosts without persistent disks, e.g. Render env vars.
# PEM values may use literal \n escapes.
USER_JWT_PUBLIC_KEY=
USER_JWT_SECRET=
AI_CONTEXT_PRIVATE_KEY=
AI_CONTEXT_PUBLIC_KEY=
AI_CONTEXT_KEY_ID=ai-context-2026-11
AI_CONTEXT_ISSUER=campusvote-api
AI_CONTEXT_AUDIENCE=campusvote-agent-ai
AI_CONTEXT_TTL_SECONDS=60
AI_JTI_STATE_TTL_SECONDS=90
AI_CHAT_TIMEOUT_MS=25000
AI_TOOL_TIMEOUT_MS=5000
AI_MAX_TOOL_CALLS=5
AI_TOOL_AGGREGATE_MAX_BYTES=524288
REDIS_URL=
ALLOW_IN_MEMORY_REPLAY=true
CAMPUSVOTE_BACKEND_URL=https://campusvote-rg13.onrender.com
CAMPUSVOTE_AUTH_MODE=user_jwt
CAMPUSVOTE_TOOL_RESPONSE_ENVELOPE_REQUIRED=true
CAMPUSVOTE_VERIFY_SITE_PATH=/api/internal/ai/site/verify
CAMPUSVOTE_VERIFY_FAIR_PATH=/api/fairs/:fairId
TOOL_GET_SITE_OVERVIEW_PATH=/api/internal/ai/site/overview
TOOL_GET_SITE_FAIRS_PATH=/api/internal/ai/site/fairs
TOOL_GET_SITE_PROJECTS_PATH=/api/internal/ai/site/projects
TOOL_GET_SITE_STANDS_PATH=/api/internal/ai/site/stands
TOOL_GET_SITE_RESULTS_PATH=/api/internal/ai/site/results
TOOL_GET_SITE_OVERVIEW_METHOD=GET
TOOL_GET_SITE_FAIRS_METHOD=GET
TOOL_GET_SITE_PROJECTS_METHOD=GET
TOOL_GET_SITE_STANDS_METHOD=GET
TOOL_GET_SITE_RESULTS_METHOD=GET
TOOL_CREATE_FAIR_RUBRIC_PATH=/api/fairs/:fairId/rubric
TOOL_ADD_FAIR_RUBRIC_CRITERION_PATH=/api/fairs/:fairId/rubric/criteria
TOOL_CREATE_FAIR_RUBRIC_METHOD=POST
TOOL_ADD_FAIR_RUBRIC_CRITERION_METHOD=POST
TOOL_CREATE_FAIR_PATH=/api/fairs
TOOL_UPDATE_FAIR_PATH=/api/fairs/:fairId
TOOL_CHANGE_FAIR_STATUS_PATH=/api/fairs/:fairId/status
TOOL_LIST_FAIR_STANDS_PATH=/api/fairs/:fairId/stands
TOOL_CREATE_FAIR_STAND_PATH=/api/fairs/:fairId/stands
TOOL_UPDATE_FAIR_STAND_PATH=/api/fairs/:fairId/stands/:standId
TOOL_DELETE_FAIR_STAND_PATH=/api/fairs/:fairId/stands/:standId
TOOL_CREATE_FAIR_METHOD=POST
TOOL_UPDATE_FAIR_METHOD=PUT
TOOL_CHANGE_FAIR_STATUS_METHOD=POST
TOOL_LIST_FAIR_STANDS_METHOD=GET
TOOL_CREATE_FAIR_STAND_METHOD=POST
TOOL_UPDATE_FAIR_STAND_METHOD=PUT
TOOL_DELETE_FAIR_STAND_METHOD=DELETE
LLM_PROVIDER=openai-compatible
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
AI_CONVERSATION_MAX_MESSAGES=20
AI_CONVERSATION_TTL_SECONDS=1800
